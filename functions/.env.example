# These are NOT read from a .env file in production — Cloud Functions
# secrets are set with the Firebase CLI and injected at runtime:
#
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#   firebase functions:secrets:set STRIPE_PRICE_ID
#
# This file just documents what's required. For local emulation, the
# Firebase emulator will prompt to load secret values into
# functions/.secret.local (gitignored) — see:
# https://firebase.google.com/docs/functions/config-env?gen=2nd#secret-manager

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
