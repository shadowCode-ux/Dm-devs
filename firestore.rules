rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile data — anyone signed in can view all profiles (for
    // Discovery and public profile pages). You can fully edit your own doc.
    // Anyone else signed in may ONLY touch the `views` field (a visitor
    // incrementing your real view counter) — nothing else.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
      );
      allow delete: if false;
    }

    // Follow relationships — doc id format: "{followerId}_{followingId}"
    // Anyone signed in can read (needed to show follower counts / follow state),
    // but you can only create/delete a follow document where YOU are the follower.
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // Community projects — publicly readable (shown on the public Projects
    // showcase page). Only the author can fully edit/delete their own
    // submission; anyone else signed in may ONLY touch the `views` field.
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
      );
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    // Team members — publicly readable (shown on the public Team page), but
    // never writable from the client. Manage this collection manually via the
    // Firebase Console, since it represents your actual real team, not
    // user-generated content.
    match /team/{memberId} {
      allow read: if true;
      allow write: if false;
    }

    // Events — publicly readable (shown on the Community page), but never
    // writable from the client. Manage via the Firebase Console.
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Public homepage stats — a single counter document, publicly readable so
    // logged-out visitors see real numbers. Any signed-in user can increment
    // it (only ever done by our own app code when a real action happens —
    // signup, project submitted, follow made), never by anonymous clients.
    match /publicStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Notifications — only the recipient can ever read their own
    // notifications. Anyone signed in can create one addressed to someone
    // else (that's how a "so-and-so followed you" notice gets delivered),
    // as long as they're honestly identifying themselves as the actor.
    // The recipient may only ever flip `read` — nothing else.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.actorId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }
  }
}
